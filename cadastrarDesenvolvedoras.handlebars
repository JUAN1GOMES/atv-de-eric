<form action="/Devs/cadastrar" method="POST">

  <div>
      <label>Nome do desenvolvedor</label>
    <input type="text" name="nome">
  </div>

  <br>

  <div>
    <label>Em que area ele trabalhou?</label>
    <input type="text" name="funcao">
  </div>

<div>
    <label>Qual o salário recebido?</label>
    <input type="number" name="salario">
  </div>

  <br>
<div>
      <label>Contribuicoes:</label>
    <select name="contribicoes" multiple>
      {{#each Jogo}}
        <option value="{{this.id}}">{{this.nome}}</option>
      {{/each}}
    </select>
  </div>

  <button type="submit">
    Cadastrar
  </button>

</form>